{
  "name": "karkas-engine",
  "version": "4.10.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-engine-example.mjs && vite build",
    "test": "node --test src/*.test.mjs",
    "mcp": "node mcp/server.mjs",
    "example": "node scripts/build-engine-example.mjs",
    "test:mcp": "node --test src/mcp-engine.test.mjs",
    "demo": "node scripts/demo-mcp.mjs",
    "format": "prettier --write \"src/**/*.{js,mjs,jsx}\" \"mcp/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs,jsx}\" \"mcp/*.mjs\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
